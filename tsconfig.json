{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "target": "esnext",
    "declaration": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@ant-design/agentic-ui": ["./src"],
      "@ant-design/agentic-ui/*": ["src/*", "*"]
    }
  },
  "include": [
    "docs/demos/**/*",
    "docs/components/**/*",
    "src/**/*",
    "src/MarkDown/demos/.tsx",
    "docs/pure.tsx",
    "home/**/*"
  ],
  "exclude": [
    "home/demo-components",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests/**",
    "website",
    "docs-dist"
  ]
}
